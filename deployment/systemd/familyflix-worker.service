[Unit]
Description=FamilyFlix By DemureGram - Media Transcoding & Rights Verification Worker
After=network.target familyflix-api.service
Wants=familyflix-api.service

[Service]
Type=simple
User=familyflix
Group=familyflix
WorkingDirectory=/var/www/familyflix
EnvironmentFile=/etc/familyflix/.env
ExecStart=/usr/bin/node scripts/media-worker.mjs
Restart=always
RestartSec=10s
LimitNOFILE=65536

# Security & Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/media/familyflix /var/log/familyflix

StandardOutput=append:/var/log/familyflix/worker.log
StandardError=append:/var/log/familyflix/worker-error.log

[Install]
WantedBy=multi-user.target
