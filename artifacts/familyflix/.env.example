# Active Vite app and shared API server.
# Replit supplies DATABASE_URL and SESSION_SECRET; do not copy secret values here.

# Optional explicit Better Auth site origin and comma-separated allowed origins.
# Set these after the app's actual domain is known; do not use a wildcard.
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=

# Bootstrap only the intended first administrator; regular sign-ups stay members.
INITIAL_ADMIN_EMAIL=

# Required for Cloudflare Stream direct uploads and processing sync.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Optional public copyright contact details. These are displayed publicly only
# when all three are supplied; use verified details approved by the operator.
COPYRIGHT_CONTACT_NAME=
COPYRIGHT_CONTACT_EMAIL=
COPYRIGHT_CONTACT_ADDRESS=
