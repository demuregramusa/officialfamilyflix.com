# Admin backend (FamilyFlix)
DATABASE_URL=
BETTER_AUTH_SECRET=

# Cloudflare Stream — uploads, transcoding and playback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Optional: sign playback URLs with short-lived RS256 tokens
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=
# Optional: require x-webhook-secret on /api/webhooks/cloudflare-stream
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# TMDb — optional metadata and artwork import
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Public site origin used for canonical URLs, sitemap and developer docs
NEXT_PUBLIC_SITE_URL=

# Developer API — comma-separated partner keys issued after the one-time license
DEVELOPER_API_KEYS=
